<div class="p-3">
  <h1><%= @task.title %></h1>
</div>

<div class="border rounded p-3 bg-light text-dark p-3">
  <p><%= @task.details %></p>
</div>

<div class="border-bottom form-check p-3">
  <% if @task.completed? %>
    <input class="form-check-input ms-2" type="checkbox" checked id="flexCheckDefault">
    <label class="form-check-label ms-2" for="flexCheckDefault">This task is completed</label>
  <% else %>
    <input class="form-check-input ms-2" type="checkbox" id="flexCheckDefault">
    <label class="form-check-label ms-2" for="flexCheckDefault">This task is not completed</label>
  <% end %>
</div>


<div class="border-bottom p-3">
  <%= link_to 'Edit your task', edit_task_path(@task) %>
</div>

<div class="border-bottom p-3">
  <%= link_to 'Delete',
    task_path(@task),
    data: {turbo_method: :delete, turbo_confirm: "Are you sure?"}
  %>
</div>

<div class="border-bottom p-3">
 <%= link_to 'Back to all tasks', tasks_path %>
</div>
